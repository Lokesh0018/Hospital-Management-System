# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MySQL on localhost:3306)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE  (URL-encode special chars in the password)
DATABASE_URL="mysql://root:YOUR_PASSWORD@localhost:3306/hms_db"

# JWT Authentication Secrets
JWT_ACCESS_SECRET="hms_super_secret_access_key_change_in_production_2026_xyz"
JWT_REFRESH_SECRET="hms_super_secret_refresh_key_change_in_production_2026_xyz"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS Configuration
CORS_ORIGIN="http://localhost:3000"
